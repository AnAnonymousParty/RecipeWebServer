<form action="EditConfiguration" 
      id="EditConfigurationForm" 
      method="post" 
      name="EditConfigurationForm"> 
 <br>
 <div class="centered"> 
  <div class="recipe-line">
   <span class="field-header">
    Units of Measure:
   </span>
   <span class="field-value">
    <select id="units" name="units">
     <%  
      Object.keys(enums.SystemOfUnitsTypes).forEach(function(key, index) { 
     %>
      <% var s = (key == configMgr.GetNativeUnits() ? "selected" : " "); %>
      <option <%=s%> value="<%=key %>"><%=this[key]%></option>
     <% 
      }, enums.SystemOfUnitsTypes); 
     %>
    </select>
   </span>
  </div>
  
  <div class="recipe-line">
   <span class="field-header">
    Validate Uploaded Files:
   </span>
   <span class="field-value">
    <select id="validateFiles" name="validateFiles"> 
     <option <%= ((true  == configMgr.IsValidateUploadedFileEnabled()) ? "selected" : " "); %> value="Y">Yes</option>
     <option <%= ((false == configMgr.IsValidateUploadedFileEnabled()) ? "selected" : " "); %> value="N">No</option>
    </select>
   </span>
  </div>  
 </div>
 <br>
 <div class="centered">
 <img height="32px" 
      onclick="PopupBehaviors.RevealPopup('<%= enums.PopupTypes.ImportRecipes %>', '<%= enums.PopupTypes.Settings %>');" 
      src="/images/Buttons/ImportBtn_48X48.png" 
      title=" <%= enums.GetDescFromPopupType(enums.PopupTypes.ImportRecipes); %>" 
      width="32px">
 &nbsp;
 <img height="32px" 
      onclick="PopupBehaviors.RevealPopup('<%= enums.PopupTypes.ExportRecipes %>', '<%= enums.PopupTypes.Settings %>');" 
      src="/images/Buttons/ExportBtn_60X48.png" 
      title=" <%= enums.GetDescFromPopupType(enums.PopupTypes.ExportRecipes); %>" 
      width="32px">    
</div>
 </form>  
