<?xml version="1.0"?>
<Recipe>
  <Title image="Beef Stew_Beef Stew.jpg" name="Beef Stew" category="STEW" cuisine="AMERICAN" nativeUnits="US">
    <Yield amount="8" units="SERVING"/>
    <Times prep="20" cook="120"/>
  </Title>
  <Nutrition calories="0" fat="0" saturatedFat="0" cholesterol="0" carbs="0" protein="0" sugar="0" sodium="0" fiber="0" servings="1" servingsUnit="CUP"/>
  <Description>Tender chunks of beef, with carrots and potatoes in a thick beefy broth.</Description>
  <Prerequisites/>
  <Ingredients>
    <Ingredient type="INGREDIENT">
      <Name>Chuck Roast or </Name>
      <Quantity units="POUND">1</Quantity>
      <Prep>CUBED</Prep>
      <Notes/>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Bacon fat</Name>
      <Quantity units="TBSP">3</Quantity>
      <Prep>NONE</Prep>
      <Notes>For searing meat and making roux.</Notes>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>AP flour</Name>
      <Quantity units="TBSP">4</Quantity>
      <Prep>NONE</Prep>
      <Notes>For dredging meat and making roux.</Notes>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>@@Brown Beef Stock@@</Name>
      <Quantity units="CUP">2</Quantity>
      <Prep>NONE</Prep>
      <Notes/>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Russet Potatoes</Name>
      <Quantity units="EACH">4</Quantity>
      <Prep>QUARTERED</Prep>
      <Notes>Peeled.</Notes>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Carrrots</Name>
      <Quantity units="CUP">2</Quantity>
      <Prep>SLICED</Prep>
      <Notes>Peeled.</Notes>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Celery</Name>
      <Quantity units="STALK">2</Quantity>
      <Prep>SLICED</Prep>
      <Notes/>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Yellow Onion</Name>
      <Quantity units="EACH">1</Quantity>
      <Prep>MINCED</Prep>
      <Notes/>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Bay Leaves</Name>
      <Quantity units="EACH">2</Quantity>
      <Prep>NONE</Prep>
      <Notes/>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Fresh Rosemary</Name>
      <Quantity units="SPRIG">1</Quantity>
      <Prep>CHOPFINE</Prep>
      <Notes>Stem discarded.</Notes>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Kosher/Sea Salt</Name>
      <Quantity units="TSP">1</Quantity>
      <Prep>NONE</Prep>
      <Notes>To taste.</Notes>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Thyme</Name>
      <Quantity units="TSP">1</Quantity>
      <Prep>NONE</Prep>
      <Notes/>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Black Pepper</Name>
      <Quantity units="TSP">1</Quantity>
      <Prep>NONE</Prep>
      <Notes>To taste.</Notes>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Red Pepper Flakes</Name>
      <Quantity units="PINCH">1</Quantity>
      <Prep>NONE</Prep>
      <Notes/>
    </Ingredient>
  </Ingredients>
  <Method>
    <Step type="STEP" image="">Season the meat with salt in pepper, then dredge in flour. What you want is a really light dusting flour, not a breaded coating.</Step>
    <Step type="STEP" image="">Melt bacon fat and continue heating until it begins to smoke, add the meat and sauté quickly until it is just well browned -you aren't trying to cook it thoroughly at this point. </Step>
    <Step type="STEP" image="">Transfer meat to a large stock pot. Add stock. You could use canned broth, but ... and if you do I'd add a can of canned beef consommé. Add water, bay leaves and red pepper flakes and set to boil. </Step>
    <Step type="STEP" image="">Meanwhile, peel and dice onions, add to pot. Trim and slice celery, add to pot. Peel and slice carrots, add to pot. Reduce heat to simmer and cook for 1-2 hours.</Step>
    <Step type="STEP" image="">Peel and quarter potatoes, add to pot. Add rosemary. Simmer until potatoes are fork-tender, probably another 20 minutes.</Step>
    <Step type="STEP" image="">The starches from the flour and potatoes should have thickened the liquid by now. If you want it thicker, add a little &lt;a href='/GetRecipe?recipeName=Brown%20Roux'&gt;Brown Roux&lt;/a&gt; until you get the right consistency.</Step>
    <Step type="STEP" image="">Adjust the seasoning, serve with &lt;a href='/GetRecipe?recipeName=Buttermilk%20Drop%20Biscuits'&gt;Buttermilk Biscuits&lt;/a&gt;. </Step>
  </Method>
  <Variations/>
</Recipe>