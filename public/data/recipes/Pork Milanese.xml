<?xml version="1.0"?>
<Recipe>
  <Title image="Pork Milanese_PorkMilanese.jpg" name="Pork Milanese" category="ENTREE_PORK" cuisine="ITALIAN" nativeUnits="US">
    <Yield amount="6" units="SLICE"/>
    <Times prep="15" cook="35"/>
  </Title>
  <Nutrition calories="385" fat="28" saturatedFat="7" cholesterol="120" carbs="9" protein="26" sugar="1" sodium="340" fiber="1" servings="1" servingsUnit="ITEM"/>
  <Description>Tender slices of pork, breaded and fried.</Description>
  <Prerequisites>
    <Prerequisite>Arrange 3 shall pans for treating @@Standard Breading Method - A l'Alglaise@@.</Prerequisite>
    <Prerequisite>Place 2 cooling racks in 2 sheet pans.</Prerequisite>
  </Prerequisites>
  <Ingredients>
    <Ingredient type="INGREDIENT">
      <Name>Boneless pork chop</Name>
      <Quantity units="EACH">6</Quantity>
      <Prep>POUNDED</Prep>
      <Notes>~5 ozs.</Notes>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Eggs</Name>
      <Quantity units="EACH">2</Quantity>
      <Prep>BEATEN</Prep>
      <Notes/>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>AP Flour</Name>
      <Quantity units="CUP">1</Quantity>
      <Prep>NONE</Prep>
      <Notes/>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Panko bread crumbs</Name>
      <Quantity units="CUP">1</Quantity>
      <Prep>NONE</Prep>
      <Notes/>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>@@Parmesan@@ cheese</Name>
      <Quantity units="CUP">.5</Quantity>
      <Prep>GRATE</Prep>
      <Notes/>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Kosher Salt</Name>
      <Quantity units="TBSP">1</Quantity>
      <Prep>NONE</Prep>
      <Notes>To taste.</Notes>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Black Pepper</Name>
      <Quantity units="TSP">1</Quantity>
      <Prep>GROUND</Prep>
      <Notes/>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Oil</Name>
      <Quantity units="CUP">.33</Quantity>
      <Prep>NONE</Prep>
      <Notes>For frying.</Notes>
    </Ingredient>
    <Ingredient type="INGREDIENT">
      <Name>Lemon</Name>
      <Quantity units="EACH">1</Quantity>
      <Prep>NONE</Prep>
      <Notes>Cut into wedges.</Notes>
    </Ingredient>
  </Ingredients>
  <Method>
    <Step type="STEP" image="">Season pork chops with salt and pepper.</Step>
    <Step type="STEP" image="">Add flour to one of the three pans, beaten eggs in the second, and panko and parmesan cheese to the third.</Step>
    <Step type="STEP" image="">Dredge pork chops in flour, shake off excess (the meat should be just dusted). dip in the beaten eggs, then into the bread crumbs to coat. Place on cooling rack.</Step>
    <Step type="STEP" image="">Heat oil in a skillet until simmering.</Step>
    <Step type="STEP" image="">Fry chops, two or three at a time (avoid crowding in the skillet, until golden brown on both sides. Transfer to cooling rack to drain excess oil.</Step>
  </Method>
  <Variations>
    <Variation>Can substitute pork tenderloin.</Variation>
    <Variation>Serve with @@Spinach Pomegranate Grapefruit Salad@@.</Variation>
  </Variations>
</Recipe>